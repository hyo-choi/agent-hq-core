# Agent HQ 진행판 환경변수 예시. 모든 값은 선택이다.
# 서버는 .env를 자동으로 읽지 않는다. 레포 루트에서 아래처럼 현재 셸에 반영한 뒤 같은 셸에서 실행한다.
#   cp .env.example .env
#   set -a; . ./.env; set +a
#   cd apps/dashboard && python3 server.py init
# 이 파일은 일반 셸 문법이다. 실제 .env는 .gitignore로 추적하지 않는다.

# 실행 데이터 루트(public/data.json, private/, backups/). 레포 밖 경로를 쓴다.
HQ_DASH_ROOT="$HOME/.local/share/agent-hq-core"

# --- 외부 연동: 모두 기본 꺼짐. 필요할 때만 주석을 풀고 자기 값으로 바꾼다 ---

# GitHub PR 읽기 전용 조회(owner/name, gh 로그인 필요)
# HQ_GITHUB_REPO="owner/name"

# Jira 스냅샷 가져오기용 프로젝트 키(서버가 Jira를 호출하지는 않는다)
# HQ_JIRA_PROJECT="PROJ"

# '지금 확인 요청'을 Codex thread로 적재. 정확히 1일 때만 켜진다
# HQ_ENABLE_CODEX_FLUSH=1
# CODEX_HOME="$HOME/.codex"
# HQ_CODEX_BIN="codex"

# check가 task 문서 첫머리의 '항목: HQ-n'을 대조할 디렉터리
# HQ_TASKS_DIR="$HOME/path/to/tasks"
